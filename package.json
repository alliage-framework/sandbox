{
  "name": "@alliage/sandbox",
  "version": "0.0.0",
  "description": "Tool to perform integration tests on an Alliage application",
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/alliage-framework/sandbox.git",
  "author": "Boris LEBON <bo.lebon@gmail.com>",
  "license": "ISC",
  "scripts": {
    "build": "rm -rf ./dist && tsc -b tsconfig.app.json",
    "lint": "eslint . --ext .js --ext .ts",
    "lint:fix": "yarn lint --fix",
    "test:unit": "NODE_ENV=test vitest run --coverage",
    "test": "yarn lint && yarn test:unit",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@semantic-release/changelog": "^6.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/coverage-v8": "3.1.1",
    "eslint": "^9.24.0",
    "glob": "^11.0.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.3",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vitest": "^3.1.1"
  }
}
